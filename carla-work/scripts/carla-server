#!/usr/bin/env bash
# Run a headless CARLA server in the Sikarugir wrapper, in the foreground.
#
# Usage:
#   scripts/carla-server [--offscreen | --window] [--port N] [--every S]
#   scripts/carla-server stop
#
# The server runs -nullrhi (no rendering; a camera sensor crashes the server)
# unless --offscreen renders through D3DMetal with no window, or --window
# opens the normal 1280x720 window. Closing the window ends the command.
# The command prints a status row every S seconds (default 10; 0 for none) and
# an EVENT line when the server comes up, a client connects or disconnects,
# or the server exits. Ctrl+C, kill, or closing the terminal stops the server.
# 'stop' ends a server that a killed command left behind. The log is .carla/server.log.

set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT/scripts/carla-env.sh"

LOG_DIR="$ROOT/.carla"
LOG="$LOG_DIR/server.log"
LAUNCHED="$LOG_DIR/launched"
CRASHES="$DRIVE_C/users/Sikarugir/AppData/Local/CarlaUE4/Saved/Crashes"
BEGAN=$SECONDS

usage() {
  sed -n 2,14p "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

server_pids() { pgrep -f 'CarlaUE4' || true; }
shipping_pid() { pgrep -f 'CarlaUE4-Win64-Shipping' | head -1 || true; }
wine_pids() { pgrep -x wineserver || true; }
port_open() { nc -z 127.0.0.1 "$1" 2>/dev/null; }

# Current and peak physical footprint in MB. Not RSS: RSS leaves out the Metal graphics
# memory of --offscreen.
memory() {
  [[ -z "$1" ]] && { echo "- -"; return; }
  footprint -f bytes --noCategories -p "$1" 2>/dev/null | awk '
    /phys_footprint:/ { now = $2 } /phys_footprint_peak:/ { peak = $2 }
    END { if (now == "") print "- -"; else printf "%d %d\n", now / 1048576, peak / 1048576 }'
}

cpu() {
  [[ -z "$1" ]] && { echo "-"; return; }
  ps -o %cpu= -p "$1" | awk '{printf "%d%%", $1}'
}

# Each client holds one connection to the RPC port on the server side.
clients() {
  [[ -z "$1" ]] && { echo 0; return; }
  lsof -nP -a -p "$1" -iTCP:"$2" -sTCP:ESTABLISHED 2>/dev/null | grep -c ":$2->" || true
}

# UE4 writes a crash report folder per crash. Prints the folder and its error message
# for each complete report written since this launch.
new_crashes() {
  [[ -d "$CRASHES" ]] || return 0
  local dir
  find "$CRASHES" -mindepth 1 -maxdepth 1 -type d -newer "$LAUNCHED" | while read -r dir; do
    [[ -f "$dir/CrashContext.runtime-xml" ]] || continue
    printf '%s\t%s\n' "$dir" "$(sed -n 's/.*<ErrorMessage>\([^<]*\).*/\1/p' "$dir/CrashContext.runtime-xml" | head -1)"
  done
}

# Sikarugir sets these when D3DMetal is checked in Configure.app.
use_d3dmetal() {
  local renderer="$APP/Contents/Frameworks/renderer/d3dmetal"
  export CX_ROOT="$SS/wine"
  export CX_D3DMETALPATH="$renderer"
  export CX_APPLEGPTK_LIBD3DSHARED_PATH="$renderer/external/libd3dshared.dylib"
  export CX_APPLEGPT_LIBD3DSHARED_PATH="$renderer/external/libd3dshared.dylib"
  export WINEDLLPATH_D3DMETAL="$renderer/wine"
  export WINEDLLPATH_PREPEND="$renderer/wine"
}

# Ends every Wine process of the wrapper, including running clients. Fails if any remain.
stop_all() {
  [[ -z "$(server_pids)$(wine_pids)" ]] && return 0
  wineserver -k 2>/dev/null || true
  for _ in $(seq 1 30); do
    [[ -z "$(server_pids)$(wine_pids)" ]] && return 0
    sleep 1
  done
  pkill -9 -f 'CarlaUE4' || true
  pkill -9 -x wineserver || true
  sleep 2
  [[ -z "$(server_pids)$(wine_pids)" ]]
}

elapsed() {
  local s=$((SECONDS - BEGAN))
  if [[ $s -ge 3600 ]]; then
    printf '%d:%02d:%02d' $((s / 3600)) $((s % 3600 / 60)) $((s % 60))
  else
    printf '%d:%02d' $((s / 60)) $((s % 60))
  fi
}

row() { printf '%8s  %-7s  %9s  %9s  %5s  %7s\n' "$@"; }
event() { printf '%8s  EVENT %s\n' "$(elapsed)" "$*"; }

finish() {
  trap '' INT TERM HUP
  event "stopping the server"
  if stop_all; then
    echo "stopped"
  else
    echo "carla-server: processes remain after stop:" >&2
    pgrep -fl 'CarlaUE4|wineserver' >&2 || true
  fi
  trap - EXIT
  exit "$1"
}

serve() {
  local port=2000 every=10 mode=nullrhi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --offscreen) [[ "$mode" == nullrhi ]] || usage; mode=offscreen ;;
      --window) [[ "$mode" == nullrhi ]] || usage; mode=window ;;
      --port) port="${2:-}"; shift ;;
      --every) every="${2:-}"; shift ;;
      *) usage ;;
    esac
    shift
  done
  [[ "$port" =~ ^[0-9]+$ && "$every" =~ ^[0-9]+$ ]] || usage

  if [[ -n "$(server_pids)" ]] || port_open "$port"; then
    echo "carla-server: a CARLA server already runs, maybe in another terminal." >&2
    echo "Stop it there with Ctrl+C, or run 'scripts/carla-server stop'." >&2
    exit 1
  fi
  if [[ -n "$(wine_pids)" ]]; then
    echo "carla-server: Wine processes of the wrapper remain (a crash dialog may be open)." >&2
    echo "Run 'scripts/carla-server stop' first." >&2
    exit 1
  fi
  if [[ -z "$CARLA_DIR" ]]; then
    echo "carla-server: no CarlaUE4.exe under C:\\Program Files in $APP (carla-mac-os guide, Step 4)" >&2
    exit 2
  fi

  local flags=(-carla-rpc-port="$port" -nosound)
  case "$mode" in
    nullrhi) flags=(-nullrhi "${flags[@]}") ;;
    offscreen) use_d3dmetal; flags=(-RenderOffScreen -quality-level=Low "${flags[@]}") ;;
    window) use_d3dmetal; flags=(-windowed -ResX=1280 -ResY=720 -quality-level=Low "${flags[@]}") ;;
  esac

  mkdir -p "$LOG_DIR"
  touch "$LAUNCHED"
  echo "CARLA ($mode) on port $port; log: ${LOG#"$ROOT"/}; Ctrl+C stops the server"

  trap 'echo; finish 130' INT
  trap 'echo; finish 143' TERM
  trap 'echo; finish 129' HUP
  trap 'stop_all || true' EXIT

  # A subshell, not nohup: macOS strips DYLD_* variables from protected binaries like nohup.
  # The redirect covers the whole subshell, so no process holds the terminal open.
  (cd "$CARLA_DIR" && exec wine "$(to_windows "$CARLA_DIR/CarlaUE4.exe")" "${flags[@]}") \
    < /dev/null > "$LOG" 2>&1 &
  # Without disown, bash prints its own job line when the server is killed.
  disown

  BEGAN=$SECONDS
  row uptime state "memory MB" "peak MB" cpu clients

  local state=loading count=0 now pid due=$SECONDS dir message now_mb peak_mb
  while true; do
    pid="$(shipping_pid)"
    # A crashed server keeps its port open behind a Windows dialog, so check the reports.
    while IFS=$'\t' read -r dir message; do
      event "crash: ${message:-no error message}"
      echo "          report: ${dir/#"$HOME"/~}"
      if [[ "$mode" == nullrhi ]]; then
        echo "          A camera sensor crashes the server in this mode. Remove it, or use --offscreen."
      fi
      finish 1
    done < <(new_crashes)
    if [[ -z "$(server_pids)" && $((SECONDS - BEGAN)) -ge 5 ]]; then
      if [[ "$mode" == window ]]; then
        event "the window was closed"
        exit 0
      fi
      event "the server exited"
      # The log holds little but MoltenVK device details; show the rest.
      grep -v -e '^\[mvk-info\]' -e $'^\t' -e '^msync:' "$LOG" | tail -n 15 || true
      exit 1
    fi

    if port_open "$port"; then
      if [[ "$state" != up ]]; then
        event "up: port $port accepts connections"
        state=up due=$SECONDS
      fi
      now="$(clients "$pid" "$port")"
      if [[ "$now" -gt "$count" ]]; then
        event "client connected ($now connected)"
      elif [[ "$now" -lt "$count" ]]; then
        event "client disconnected ($now connected)"
      fi
      count=$now
    elif [[ "$state" == up ]]; then
      event "port $port closed; the server may have crashed (look for a Windows dialog)"
      state=down count=0
    fi

    if [[ $every -gt 0 && $SECONDS -ge $due ]]; then
      read -r now_mb peak_mb <<< "$(memory "$pid")"
      row "$(elapsed)" "$state" "$now_mb" "$peak_mb" "$(cpu "$pid")" "$([[ $state == up ]] && echo "$count" || echo -)"
      due=$((SECONDS + every))
    fi
    sleep 1
  done
}

stop() {
  if [[ -z "$(server_pids)$(wine_pids)" ]]; then
    echo "no CARLA or Wine process is running"
    return 0
  fi
  if ! stop_all; then
    echo "carla-server: processes remain after stop:" >&2
    pgrep -fl 'CarlaUE4|wineserver' >&2 || true
    exit 1
  fi
  echo "stopped"
}

case "${1:-}" in
  stop) stop ;;
  -h|--help|help) usage ;;
  *) serve "$@" ;;
esac
