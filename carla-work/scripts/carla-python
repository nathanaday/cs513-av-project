#!/usr/bin/env bash
# Run the wrapper's Windows Python from a macOS terminal.
#
# Usage:
#   scripts/carla-python <script.py> [args...]    run a script (macOS or Windows path)
#   scripts/carla-python -m pip install <pkg>     any python.exe arguments work
#
# Copied from github.com/nathanaday/carla-mac-os at 8606c8f. See carla-env.sh.

set -euo pipefail
source "$(dirname "$0")/carla-env.sh"

PYTHON="$(find "$DRIVE_C/Program Files" -maxdepth 2 -name python.exe -path '*Python3*' | sort | tail -1)"
if [[ -z "$PYTHON" ]]; then
  echo "carla-python: no Windows Python under C:\\Program Files (carla-mac-os guide, Step 8)" >&2
  exit 2
fi

# The agents package ships with CARLA, not in the carla wheel.
if [[ -n "$CARLA_DIR" ]]; then
  export PYTHONPATH="$(to_windows "$CARLA_DIR/PythonAPI/carla")${PYTHONPATH:+;$PYTHONPATH}"
fi
# Shared runner modules, such as runlog.
export PYTHONPATH="$(to_windows "$(dirname "$0")/../client-runners");$PYTHONPATH"

args=()
for a in "$@"; do
  if [[ "$a" == *.py && -f "$a" ]]; then
    args+=("$(to_windows "$a")")
  else
    args+=("$a")
  fi
done

# The ${a[@]+...} form keeps bash 3.2 under set -u from failing on no arguments.
exec wine "$(to_windows "$PYTHON")" -u ${args[@]+"${args[@]}"}
